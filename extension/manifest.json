{
  "manifest_version": 3,
  "name": "Price Tracker",
  "version": "0.1.0",
  "description": "One-click add to your Price Tracker.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "tabs", "contextMenus", "storage", "scripting"],
  "host_permissions": ["https://prices.schultzsolutions.tech/*"],
  "content_scripts": [
    {
      "matches": ["https://no-such-host.invalid/*"],
      "js": ["src/content/picker.ts"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Open Price Tracker popup"
    }
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Price Tracker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
